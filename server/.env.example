# نام دامنه‌ای که به IP سرور اشاره می‌کند. Caddy برای همین گواهی می‌گیرد.
DOMAIN=lamoo.example.com

# پورت داخلی؛ از بیرون فقط Caddy دیده می‌شود.
PORT=8787

# مسیر فایل دیتابیس داخل کانتینر. بکاپ = کپی کردن همین فایل.
DB_PATH=/data/lamoo.db

# بعد از اینکه خودت و خانواده و دوستانت ثبت‌نام کردید، این را 0 کن تا سرور بسته شود.
ALLOW_REGISTRATION=1

# دامنه‌ای که اپ از آن سرو می‌شود. * هم مشکلی ندارد چون احراز هویت با توکن است نه کوکی.
CORS_ORIGIN=*

# سقف حجم تصویر کارت اشتراکی (بایت).
MAX_IMAGE_BYTES=400000

# کارت اشتراکی چند ساعت در فید دوستان بماند.
CARD_TTL_HOURS=24

# کلیدهای Web Push (VAPID). بدون اینها همه‌چیز کار می‌کند جز نوتیفیکیشن.
# ساختنشان:  docker compose run --rm api node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# چند روز مانده به انقضا نوتیفیکیشن بدهد.
EXPIRY_WARNING_DAYS=2

LOG_LEVEL=info
